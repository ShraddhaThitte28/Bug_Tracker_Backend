# Database Configuration (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bug_tracker_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Hosted PostgreSQL (e.g. Railway). Leave commented out for local development.
# When set, it takes priority over the DB_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# JWT Authentication Configuration
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated frontend origins (no wildcard). Defaults to the local Vite dev server.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.example
